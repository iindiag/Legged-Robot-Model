% Extracting the results from the LeggedRobotSim3D file

t = out.currentKnee.Time;
i = out.currentKnee.Data; % The current generated by the PD controller 
omega = out.omega_actKnee.Data; % The angular velocity of the knee joint
C_zCoords = out.C_z.Data; % The z-Coordinate of the centre of the foot

% From the Spatial Contact Force block:
tSpatialContact = out.normFHeel1.Time;
normFHeel1 = out.normFHeel1.Data;
normFToe1 = out.normFToe1.Data;
normFHeel2 = out.normFHeel1.Data;
normFToe2 = out.normFToe1.Data;

figure(1)
plot(tSpatialContact, squeeze(normFHeel1(3,1,:)), 'Color', [1, 0.2, 0.6])
hold on;
plot(tSpatialContact, squeeze(normFToe1(3,1,:)), 'b')
title('Normal Force at Food-Ground Contact')
xlabel('Time (s)')
ylabel('Normal Force (N)')
legend('Heel', 'Toes')
grid on;

totalNormF = normFHeel1(3,1,end) + normFToe1(3,1,end) + normFHeel2(3,1,end)
disp(totalNormF)


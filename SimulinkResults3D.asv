% Extracting the results from the LeggedRobotSim3D file & calculating:
% - Normal forces
% - CoT
% - MC

function PLog = PowerConsumption(K_t, currentKnee, currentHipPitch, ...
    currentHipRoll, omegaKnee, omegaHipPitch, omegaHipRoll)
% Calculates the power consumption required for movement of the legged
% robot

    N = length(currentKnee);
    
    PLog = zeros(1,N);
    
    for k = 1:N
        P = K_t * ( ...
            abs(currentHipRoll(k))  * abs(omegaHipRoll(k))  + ...
            abs(currentHipPitch(k)) * abs(omegaHipPitch(k)) + ...
            abs(currentKnee(k))     * abs(omegaKnee(k)) );
    
        PLog(k) = P;
    end

end

function COTLog = CostOfTransport(E, m, g, d)
% Calculates the cost of transport for the legged robot
% E = total energy consumption

    N = length(E);
    COTLog = zeros(N,1);
    
    for k = 1:N
    
        COT = E(k) / (m * g * d);
        COTLog(k) = COT;
    
    end

end

function MCVals = MCCalculation(B, H, C_zLog, currentLog, omegaLog)
% Quantification of Morphological Computation (MC)

    function discreteArray = discretization(B, continuousArray)
        % Pre-processing into discretized data by binning the continuous data
        % into a smaller number of bins:
        % 1) takes a continuous value
        % 2) determines which interval ('bin') it falls into
        % 3) replaces the continuous value with an integer label

        minVal = min(continuousArray);
        maxVal = max(continuousArray);

        discreteArray = floor((continuousArray - minVal) ./ ...
            (maxVal - minVal) * B); % Floor func. rounds each element down
        % to the nearest integer

        discreteArray(discreteArray == B) = B-1;

    end

% Discretizing C_z, angular velocity and electrical current signal
C_zDiscretized = discretization(B, C_zLog);
iDiscretized = discretization(B, currentLog);
omega_2Discretized = discretization(B, omegaLog);

% Calculates the world state at the current time step
w = C_zDiscretized + H * omega_2Discretized;
% Denotes the actuator state, represents the electric current signal to
% the motor
a = iDiscretized;

w_now = w(1:end-1)';
w_next = w(2:end)';
a_now = a(1:end-1)';

N = length(w_now);

MCVals = zeros(N,1);

for k = 1:N

    wp = w_next(k);
    wn = w_now(k);
    an = a_now(k);

    % p(w',w,a)
    p_wpwA = sum(w_next==wp & w_now==wn & a_now==an) / N;

    % p(w,a)
    p_wA = sum(w_now==wn & a_now==an) / N;

    % p(a)
    p_A = sum(a_now==an) / N;

    % p(w',a)
    p_wpA = sum(w_next==wp & a_now==an) / N;

    % Conditional probabilities
    alpha = p_wpwA / p_wA;
    p_wp_given_A = p_wpA / p_A;

    % Avoid log(0)
    if p_wpwA > 0 && alpha > 0 && p_wp_given_A > 0

        MC = p_wpwA * log2(alpha / p_wp_given_A);

        MCVals(k) = MC;

    end

end

end

% Loading the database
db = database();

% Extracting the relevant values from database

% PDC params.:
K_t = db.PDC.K_t;
% Dimension params.:
m = db.dims.m_1 + db.dims.m_2 + 0.486;
% MC params.:
B = db.MC.B;
H = db.MC.H;

g = 9.81;

t = out.currentKnee.Time;
iKnee = out.currentKnee.Data; % The current generated by the PD controller 
omegaKnee = out.omega_actKnee.Data; % The angular velocity of the knee joint
C_zCoords = out.C_z.Data; % The z-Coordinate of the centre of the foot

iHipPitch = out.currentHipPitch.Data;
iHipRoll = out.currentHipRoll.Data;
omegaHipPitch = out.omega_actHipPitch.Data;
omegaHipRoll = out.omega_actHipRoll.Data;

dLog = out.distanceTravelled.Data;
dNet = abs(dLog(end) - dLog(1));

% From the Spatial Contact Force blocks:
tSpatialContact = out.normFHeel1.Time;

% Leg 1:
normF1 = out.normF1.Data;
normF2 = out.normF2.Data;
normF3 = out.normF3.Data;
normF4 = out.normF4.Data;
normFHeel1 = out.normFHeel1.Data;
normFToe1 = out.normFToe1.Data;
normFCentre1 = out.normCentre1.Data;

% Leg 2:
normFCentre2 = out.normCentre2.Data;
normFHeel2 = out.normFHeel2.Data;
normFToe2 = out.normFToe2.Data;

% Creating an index for when t>=1 so that the initial jump is excluded
% -> avoids 
idx = find(tSpatialContact >= 1);

% Plotting the heel and toe Spatial Contact Force points for legs 1 and 2
figure(1)

subplot(2, 1, 1)
plot(tSpatialContact, ...
squeeze(normFHeel1(3,1,:)), 'Color', [1, 0.2, 0.6], 'LineWidth', 1.5)
hold on;
plot(tSpatialContact(idx), ...
squeeze(normFToe1(3,1,idx)), 'b--', 'LineWidth', 1.5)
title('Normal Force at Lower Link Base Contact - Leg 1')
xlabel('Time (s)')
ylabel('Normal Force (N)')
legend('Back', 'Front')
grid on;

subplot(2, 1, 2)
plot(tSpatialContact, squeeze(normFHeel2(3,1,:)), 'LineWidth', 1.5)
hold on;
plot(tSpatialContact, squeeze(normFToe2(3,1,:)), '--', 'LineWidth', 1.5)
title('Normal Force at Lower Link Base Contact - Leg 2')
xlabel('Time (s)')
ylabel('Normal Force (N)')
legend('Back', 'Front')
grid on;

saveas(gcf, 'legNormFs.png')

% Total normal force through leg 1
FTotal = normF1(3,1,end) + normF2(3,1,end) + normF3(3,1,end) + ...
    normF4(3,1,end) + normFHeel1(3,1,end) + normFToe1(3,1,end) + ...
    normFCentre1(3,1,end);

disp(['Total normal force exerted through leg 1: ', num2str(FTotal), ' N'])


% Plotting all the Spatial Contact Force blocks for leg 1
figure(2)

plot(tSpatialContact(idx), squeeze(normF1(3,1,idx)))
hold on;
plot(tSpatialContact(idx), squeeze(normF2(3,1,idx)))
hold on;
plot(tSpatialContact(idx), squeeze(normF3(3,1,idx)))
hold on;
plot(tSpatialContact(idx), squeeze(normF4(3,1,idx)))
hold on;
plot(tSpatialContact(idx), squeeze(normFToe1(3,1,idx)))
hold on;
plot(tSpatialContact(idx), squeeze(normFHeel1(3,1,idx)))
hold on;
plot(tSpatialContact(idx), squeeze(normFCentre1(3,1,idx)))
title('Normal Force at Lower Link Base Contact - Leg 1')
legend('1', '2', '3', '4', 'Front', 'Back', 'Centre')
xlabel('Time (s)')
ylabel('Normal Force (N)')
grid on

saveas(gcf, 'PiecewiseAllNormFs.png')


% Plotting the current, angular velocity and z coordinate for the 'foot' of
% leg 1
figure(3)

subplot(3,1,1)
plot(t, iKnee, 'LineWidth', 1.2)
xlabel('Time (s)')
ylabel('Current (Amps)')
title('PD Controller Output - i(t)')
grid on

subplot(3,1,2)
plot(t, omega, 'Color', [0.5 0 0.5], 'LineWidth', 1.2)
xlabel('Time (s)')
ylabel('Angular Velocity (rad/s)')
title(['Angular Velocity of the ' ...
    'Knee Joint'])
grid on

subplot(3,1,3)
plot(t, C_zCoords - 0.32, 'Color', [0.98 0.76 0.72], 'LineWidth', 1.2)
xlabel('Time (s)')
ylabel('z Position (m)')
title(['z Position of the Centre Point of the Base of the ' ...
    'Lower Link'])
grid on

saveas(gcf, 'Piecewise3Metrics.png')


% Computing the power, energy and COT
PLog = PowerConsumption(K_t, iKnee, iHipPitch, iHipRoll, ...
    omegaKnee, omegaHipPitch, omegaHipRoll);
ELog = cumtrapz(t,PLog);
COT = CostOfTransport(ELog, m, g, dNet);

% Plotting the CoT and distance walked by the robot over time
figure(4)

subplot(2,1,1)
plot(t, dLog);
xlabel('Time (s)')
ylabel('Distance (m)')
title('Distance travelled ')

subplot(2,1,1)
plot(t, dLog);
xlabel('Time (s)')
grid on

% Computing the MC
MCVals = MCCalculation(B, H, C_zCoords, iKnee, omega);
MCSmooth = smoothdata(MCVals, 'gaussian', 5);

figure(6)
plot(t(1:end-1), MCSmooth, 'LineWidth', 1.5);
xlabel('Time (s)');
ylabel('Morphological Computation (MC)');
title('Smoothed Morphological Computation Over Time');
grid on;
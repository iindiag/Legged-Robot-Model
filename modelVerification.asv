clc, clearvars

% README: Must run leggedRobotSim.m and the Simulink simulation and
% SimulinkResults.m file before running this file for the models to be 
% compared with the same used parameters.

% Loading the saved results from the models
load('dynamicModelResults.mat');
load('SimulinkResults.mat');

% Plotting the results against each other for qualitative analysis
figure(1)

plot(t_ode, currentLog_ode(:,2), 'LineWidth', 1.5)
hold on;
plot(t, i, '--', 'Color', [0.98 0.76 0.72], 'LineWidth', 2.5)
xlabel('Time (s)')
ylabel('Current (Amps)')
legend('Dynamics Model', 'Simulink Model')
title('PD Controller Output - i(t)')
grid on
saveas(gcf, 'i(t).png')

figure(2)
plot(t_ode, omegaKnee_ode, 'LineWidth', 1.5)
hold on;
plot(t, omega, '--', 'Color', [0.98 0.76 0.72], 'LineWidth', 2.5)
xlabel('Time (s)')
ylabel('Angular Velocity (rad/s)')
legend('Dynamics Model', 'Simulink Model')
title(['Angular Velocity of the' ...
    'Knee Joint'])
grid on
saveas(gcf, 'omega.png')

figure(3)
plot(t_ode, C_zCoords_ode, 'LineWidth', 1.5)
hold on;
plot(t, C_zCoords - 0.32, '--', 'Color', [0.98 0.76 0.72], 'LineWidth', 2.5)
xlabel('Time (s)')
ylabel('z Position (m)')
legend('Dynamics Model', 'Simulink Model')
title(['z Position of the Centre Point of the Base of the ' ...
    'Lower Link'])
grid on

% Computing RMSE, MAE and correlation coefficient

function RMSE = RMSEFunc(list1, list2)
% Computes the RMSE value of two lists
    
    if length(list1) ~= length(list2)
        disp('WARNING: Lists have a different number of values')
    else
        RMSE = sqrt(mean((list1 - list2).^2));
    end

end

function MAE = MAEFunc(list1, list2)
% Computes the MAE value of two lists
    
    if length(list1) ~= length(list2)
        disp('WARNING: Lists have a different number of values')
    else
        MAE = mean(abs(list1 - list2));
    end

end

function correlationCoeff = correlationCoeffFunc(list1, list2)
% Computes the correlation coefficient of two lists

    if length(list1) ~= length(list2)
        disp('WARNING: Lists have a different number of values')
    else
        correlationCoeff = corr(list1(:), list2(:));
    end

end

odeCurrentInterp = interp1(t_ode, currentLog_ode(:,2), t);
odeOmegaInterp = interp1(t_ode, omegaKnee_ode, t);
odeC_zInterp = interp1(t_ode, C_zCoords_ode, t);

% Calculate RMSE, MAE, and correlation coefficient for the interpolated 
% results
RMSECurrent = RMSEFunc(odeCurrentInterp, i);
MAECurrent = MAEFunc(odeCurrentInterp, i);
correlationCurrent = correlationCoeffFunc(odeCurrentInterp, i);

RMSEOmega = RMSEFunc(odeOmegaInterp, omega);
MAEOmega = MAEFunc(odeOmegaInterp, omega);
correlationOmega = correlationCoeffFunc(odeOmegaInterp, omega);

RMSEzCoords = RMSEFunc(odeC_zInterp, C_zCoords - 0.32);
MAEzCoords = MAEFunc(odeC_zInterp, C_zCoords - 0.32);
correlationzCoords = correlationCoeffFunc(odeC_zInterp, C_zCoords - 0.32);

disp('--- PD Controller Output: Current ---')
disp(['RMSE: ' num2str(RMSECurrent)])
disp(['MAE: ' num2str(MAECurrent)])
disp(['Correlation coefficient: ' num2str(correlationCurrent)])

disp('--- Angular Velocity of the Knee Joint ---')
disp(['RMSE: ' num2str(RMSEOmega)])
disp(['MAE: ' num2str(MAEOmega)])
disp(['Correlation coefficient: ' num2str(correlationOmega)])

disp('--- Measured z-Coordinates of the Foot Position ---')
disp(['RMSE: ' num2str(RMSEzCoords)])
disp(['MAE: ' num2str(MAEzCoords)])
disp(['Correlation coefficient: ' num2str(correlationzCoords)])